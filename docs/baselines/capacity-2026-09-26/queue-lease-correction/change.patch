+    def _assert_queue_lease_setup(self, extra, expected):
+        with tempfile.TemporaryDirectory() as directory:
+            engine = Path(directory) / "engine"
+            engine.write_text("fixture")
+            args, _ = campaign.arguments(["--engine-bin", str(engine), "--report", directory + "/report.json",
+                                          "--chain", "evm12=1"] + extra)
+            instance = campaign.Campaign.__new__(campaign.Campaign)
+            instance.args, instance.profiles = args, {}
+            instance.token, instance.namespace = "fixture", "fixture"
+            instance.redis_port, instance.engine_port = 1, 2
+            instance.journal = Path(directory) / "journal.sqlite"
+            instance.report, instance.initial = {}, {}
+            instance.resource_preflight = lambda: None
+            instance.start_redis = lambda: None
+            seen = []
+            instance.engine_command = lambda *_: seen.append(dict(instance.env))
+            instance.start_engine = lambda: seen.append(dict(instance.env))
+            with patch.dict(os.environ, {"APP__QUEUE__LEASE_DURATION_SECONDS": "17"}):
+                instance.setup()
+            self.assertEqual(args.queue_lease_seconds, expected)
+            self.assertEqual(len(seen), 2)
+            self.assertTrue(all(env["APP__QUEUE__LEASE_DURATION_SECONDS"] == str(expected) for env in seen))
+            self.assertEqual(instance.report["queue_settings"]["APP__QUEUE__LEASE_DURATION_SECONDS"], str(expected))
+
+    def test_queue_lease_default_matches_both_production_config_layers_and_actual_setup(self):
+        import re
+        for name in ("server_base.yaml", "server_production.yaml"):
+            source = (campaign.ROOT / "server/configuration" / name).read_text()
+            configured = re.search(r"^  lease_duration_seconds: ([0-9]+)$", source, re.MULTILINE)
+            self.assertIsNotNone(configured)
+            self.assertEqual(int(configured.group(1)), 600)
+        self._assert_queue_lease_setup([], 600)
+
+    def test_explicit_short_queue_lease_is_recorded_and_reaches_init_and_engine(self):
+        self._assert_queue_lease_setup(["--queue-lease-seconds", "10"], 10)
+
+    def test_queue_lease_rejects_outside_bounds_and_non_integer_values(self):
+        import contextlib
+        import io
+        with tempfile.TemporaryDirectory() as directory:
+            engine = Path(directory) / "engine"
+            engine.write_text("fixture")
+            common = ["--engine-bin", str(engine), "--report", directory + "/report.json", "--chain", "evm12=1"]
+            for valid in ("1", "3600"):
+                args, _ = campaign.arguments(common + ["--queue-lease-seconds", valid])
+                self.assertEqual(args.queue_lease_seconds, int(valid))
+            for invalid in ("0", "-1", "3601"):
+                with self.assertRaises(ValueError):
+                    campaign.arguments(common + ["--queue-lease-seconds", invalid])
+            for invalid in ("1.5", "nan", "inf"):
+                with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit):
+                    campaign.arguments(common + ["--queue-lease-seconds", invalid])
+
