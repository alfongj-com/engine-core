+@contextmanager
+def journal_reader(path):
+    """Logical SQL read-only access to an existing, potentially live WAL ledger.
+
+    A read/write SQLite handle permits WAL/SHM bookkeeping when the last writer
+    removed the sidecars. It never creates the database. query_only prohibits
+    application writes; full sync also covers a last-reader checkpoint on close.
+    This is not a physically read-only forensic handle. Never use immutable=1
+    for a live ledger: doing so can hide committed WAL rows.
+    """
+    db = sqlite3.connect(Path(path).absolute().as_uri() + "?mode=rw", uri=True, timeout=2)
+    try:
+        db.execute("PRAGMA query_only=ON")
+        db.execute("PRAGMA synchronous=FULL")
+        db.execute("PRAGMA fullfsync=ON")
+        yield db
+    finally:
+        db.close()
 
 
