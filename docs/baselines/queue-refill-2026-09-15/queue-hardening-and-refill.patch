+    assert_eq!(queue.count(JobStatus::Delayed).await.unwrap(), 0);
+    assert_eq!(queue.count(JobStatus::Failed).await.unwrap(), 1);
+    cleanup(&mut queue.redis.clone(), &format!("twmq:{}", queue.name())).await;
+}
